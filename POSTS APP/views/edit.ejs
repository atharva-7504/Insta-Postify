<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit Post</title>
<style>
    /* ===== BASE ===== */
* {
  box-sizing: border-box;
  font-family: "Segoe UI", system-ui, sans-serif;
}

body {
  margin: 0;
  min-height: 100vh;
  background: #1e1e1e;
  color: #e6e6e6;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== LAYOUT ===== */
.edit-wrapper {
  width: 100%;
  padding: 20px;
}

.edit-card {
  max-width: 560px;
  margin: auto;
  background: #2a2a2a;
  border-radius: 14px;
  padding: 30px 28px;
  box-shadow: 0 15px 40px rgba(0,0,0,0.6);
}

/* ===== HEADER ===== */
.edit-header h1 {
  margin: 0;
  font-size: 1.9rem;
  color: #f1f1f1;
}

.edit-header p {
  margin-top: 6px;
  font-size: 0.95rem;
  color: #9ca3af;
}

/* ===== FORM ===== */
.edit-form {
  margin-top: 26px;
}

.form-group {
  margin-bottom: 22px;
}

label {
  display: block;
  font-size: 0.9rem;
  margin-bottom: 6px;
  color: #d1d5db;
}

input,
textarea {
  width: 100%;
  padding: 12px 14px;
  background: #ffffff;
  color: #00154e;
  border: 1px solid #3f3f3f;
  border-radius: 8px;
  font-size: 0.95rem;
}

input:focus,
textarea:focus {
  outline: none;
  border-color: #6b7280;
}

textarea {
  min-height: 140px;
  resize: vertical;
}

/* ===== ACTIONS ===== */
.form-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 30px;
}

.btn {
  padding: 12px 26px;
  border-radius: 25px;
  font-size: 0.9rem;
  text-decoration: none;
  cursor: pointer;
  border: none;
  transition: all 0.25s ease;
}

/* Primary */
.btn.primary {
  background: #1f75ff;
  color: #f9fafb;
}

.btn.primary:hover {
  background: #0f3baa;
}

/* Secondary */
.btn.secondary {
  background: transparent;
  color: #9ca3af;
  border: 1px solid #4b5563;
}

.btn.secondary:hover {
  background: #156eff;
  color: #e5e7eb;
}

</style>
  <!-- Page-specific CSS -->
  <link rel="stylesheet" href="/edit.css">
</head>
<body>

  <main class="edit-wrapper">

    <section class="edit-card">
      <header class="edit-header">
        <h1>Edit Post</h1>
        <p>Update your content and save changes</p>
      </header>

      <form 
        class="edit-form"
        action="/posts/<%= post.id %>?_method=PATCH" 
        method="POST"
      >

        <div class="form-group">
          <label>Username</label>
          <input 
            type="text" 
            name="name" 
            value="<%= post.name %>" 
            readonly
          />
        </div>

        <div class="form-group">
          <label>Post Content</label>
          <textarea 
            name="content" 
            placeholder="Edit your post here..."
            required
          ><%= post.content %></textarea>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn primary">
            Update Post
          </button>

          <a href="/posts" class="btn secondary">
            Cancel
          </a>
        </div>

      </form>
    </section>

  </main>

</body>
</html>
